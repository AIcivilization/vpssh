{
  "name": "vpssh",
  "version": "0.1.12",
  "description": "AI-driven VPS management and SSH tool for every platform. · 全平台 AI 驱动的 VPS 管理及 SSH 工具。",
  "keywords": [
    "vps",
    "ssh",
    "ai",
    "server-management",
    "self-hosted",
    "web-terminal",
    "sysadmin"
  ],
  "license": "MIT",
  "author": "AIcivilization",
  "homepage": "https://github.com/AIcivilization/vpssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/vpssh.git",
    "directory": "plugin"
  },
  "bugs": {
    "url": "https://github.com/AIcivilization/vpssh/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "recipes/**",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --env-file=test/test.env --test test/*.test.js"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "private": true
}
