{
  "name": "dsh-vps-manager",
  "version": "0.6.5",
  "description": "Manage your VPS from DeepSeek Harness over SSH: zero-token commands, an in-conversation terminal, AI tools with risk-tiered confirmation, and a recipe library. · 在 DSH 里通过 SSH 管理 VPS：不花 token 的命令、对话里的终端、按风险分级确认的 AI 工具、菜谱库。",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugins",
    "deepseek",
    "cordis",
    "vps",
    "ssh",
    "server-management",
    "sysadmin",
    "devops",
    "self-hosted",
    "linux",
    "terminal",
    "web-terminal",
    "xterm",
    "ssh-terminal",
    "aiops",
    "ai-agent",
    "llm-tools",
    "remote-server",
    "server-admin"
  ],
  "license": "MIT",
  "author": "AIcivilization",
  "homepage": "https://github.com/AIcivilization/dsh-vps-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIcivilization/dsh-vps-manager.git"
  },
  "bugs": {
    "url": "https://github.com/AIcivilization/dsh-vps-manager/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "recipes/**",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node --env-file=test/test.env --test test/*.test.js"
  },
  "dependencies": {
    "ws": "^8.21.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
