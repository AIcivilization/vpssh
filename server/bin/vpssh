#!/usr/bin/env bash
# vpssh 管理命令（M3）
# 设计依据：vpssh-architecture-design.md §4.2.6 / §10
#
# 子命令：
#   status              服务状态 + 健康 + 版本提示
#   restart             重启 gate（DSH 子进程随之重启并自动重新兑换）
#   upgrade [version]   升级 DSH 版本（默认 latest_verified）；--latest 强上 npm 最新版
#   update-gate        更新 gate 代码本身（gate/server.js）并重启
#   rollback            符号链接切回上一版本并重启
#   reset-admin         删除 admin.json 与 setup.lock，重新走向导并换发令牌（应急）
#   setup-url           打印初始设置链接（含一次性令牌）
#   vpn                 仅我可访问：WireGuard 隧道（setup/add/revoke/list/status/on/off）——保留但不在帮助里列出
#   tunnel              仅我可访问：SSH 本地端口转发（零安装，打印用法）——保留但不在帮助里列出
#   backup              打包 DSH_HOME + state 到 backups/（保留最近 3 份）
#   selfcheck           手动触发升级回归自检探针
#   install-units       安装浏览器一键升级所需的 systemd 单元（install.sh / update-gate 调用）
#   upgrade-run         执行浏览器发起的升级请求（由 vpssh-upgrade.service 以 root 调用）

set -Eeuo pipefail
# set -e 会让脚本在任何一条命令失败时静默退出；这里把"在哪一行、哪条命令"打出来，
# 升级日志（state/upgrade.log）里就能直接看到原因，而不是戛然而止。
trap 'printf "\033[1;31m[vpssh]\033[0m 意外退出：第 %s 行 \`%s\` 返回 %s\n" "$LINENO" "$BASH_COMMAND" "$?" >&2' ERR

ROOT="${VPSSH_ROOT:-/opt/vpssh}"
# 网关端口以安装时记下的为准（新装 3190，0.1.0 装的是 3100）
GATE_PORT="${GATE_PORT:-$(sed -n 's/.*"gatePort": *\([0-9]*\).*/\1/p' "$ROOT/state/config.json" 2>/dev/null | head -1)}"
GATE_PORT="${GATE_PORT:-3190}"
HEALTH_URL="http://127.0.0.1:$GATE_PORT/gate/health"
SELFCHECK_URL="http://127.0.0.1:$GATE_PORT/gate/selfcheck"
DSH_HOME_DIR="${DSH_HOME:-/home/vpssh/.dsh}"
SERVICE="vpssh"
RAW_BASE="${VPSSH_RAW_BASE:-https://raw.githubusercontent.com/AIcivilization/vpssh/main/server}"
# DSH 版本与依赖冻结点在 manifest.json 里，由 install.sh 处理；升级就是用新版本的 install.sh 重装（见 upgrade）

log()  { printf '\033[1;32m[vpssh]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[vpssh]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[vpssh]\033[0m %s\n' "$*" >&2; exit 1; }

require_root() { [[ $EUID -eq 0 ]] || die "$(M "需要 root（sudo vpssh $*）" "Run as root (sudo vpssh $*)")"; }

current_version() { readlink "$ROOT/dsh/current" 2>/dev/null || echo "$(M "(未安装)" "(not installed)")"; }

## region: backup

cmd_backup() {
	require_root
	mkdir -p "$ROOT/backups"
	local ts="$ROOT/backups/vpssh-$(date +%Y%m%d-%H%M%S).tar.gz"
	# DSH 运行中仍在写文件：GNU tar 遇到"读取期间文件有变化"返回 1，归档本身完整，只告警；
	# 返回 2 才是真失败
	local rc=0
	tar -czf "$ts" -C / "${DSH_HOME_DIR#/}" "${ROOT#/}/state" 2>/dev/null || rc=$?
	if [[ $rc -eq 1 ]]; then
		warn "$(M "部分文件在备份期间有变动（DSH 运行中属正常），备份仍可用" "Some files changed during the backup (normal while running); the backup is fine")"
	elif [[ $rc -ne 0 ]]; then
		die "$(M "备份失败（tar 返回 $rc）" "Backup failed (tar returned $rc)")"
	fi
	chmod 600 "$ts"
	log "$(M "备份完成: $ts" "Backup written: $ts")"
	# 保留最近 3 份。写成 if：`[[ ]] && ...` 作为函数最后一行时，条件不成立会让函数返回 1，
	# 调用方在 set -e 下直接静默退出——首次升级（备份不足 4 份）就曾因此在备份后中止
	local old
	old=$(ls -1t "$ROOT"/backups/vpssh-*.tar.gz 2>/dev/null | tail -n +4 || true)
	if [[ -n "$old" ]]; then
		rm -f $old
		log "$(M "已清理旧备份" "Removed old backups")"
	fi
}

## endregion


## region: status

cmd_status() {
	echo "$(M "== 服务 ==" "== Services ==")"
	systemctl is-active "$SERVICE" 2>/dev/null | sed 's/^/  vpssh: /' || echo "  vpssh: inactive"
	systemctl is-active vpssh-keyd 2>/dev/null | sed 's/^/  keyd:  /' || echo "  keyd:  inactive"
	systemctl is-active caddy 2>/dev/null | sed 's/^/  caddy:    /' || echo "$(M "  caddy:    (未安装)" "  caddy:    (not installed)")"
	echo
	echo "$(M "== 配置 ==" "== Config ==")"
	[[ -f "$ROOT/state/config.json" ]] && sed 's/^/  /' "$ROOT/state/config.json" || echo "$(M "  (无 config.json)" "  (no config.json)")"
	echo "$(M "  当前 DSH 版本: $(current_version)" "  DSH version: $(current_version)")"
	cmd_ownshost status
	echo
	echo "$(M "== 健康 ==" "== Health ==")"
	local health
	if health=$(curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null); then
		printf '%s\n' "$health" | sed 's/^/  /'
	else
		echo "$(M "  gate 不可达（服务未运行或启动中）" "  gateway unreachable (not running, or starting)")"
	fi
	echo
	echo "== vpssh $(installed_vpssh) =="
	local latest
	latest=$(latest_release_tag)
	if [[ -n "$latest" && "${latest#v}" != "$(installed_vpssh)" ]]; then
		echo "$(M "有新版本 $latest：sudo vpssh upgrade" "New version $latest available: sudo vpssh upgrade")"
	fi
}

## endregion

## region: selfcheck

cmd_selfcheck() {
	local out
	out=$(curl -fsS --max-time 15 "$SELFCHECK_URL" 2>/dev/null) || {
		warn "$(M "selfcheck 探针不可达（gate 未运行？先 sudo systemctl restart ${SERVICE}）" "Self-check unreachable (gateway down? try sudo systemctl restart ${SERVICE})")"
		return 1
	}
	printf '%s\n' "$out"
	printf '%s' "$out" | grep -q '"pass":true'
}

wait_selfcheck() { # $1=重试次数
	local i
	for i in $(seq 1 "$1"); do
		if cmd_selfcheck >/dev/null 2>&1; then
			return 0
		fi
		warn "$(M "自检未通过（第 $i/$1 次），等待 10s 重试..." "Self-check failed ($i/$1); retrying in 10 s...")"
		sleep 10
	done
	return 1
}

## endregion

## region: upgrade / rollback

# vpssh 整体升级：每个 vpssh 版本固定一组组件（DSH 版本见 manifest.json），一起升、一起回滚。
#   1. 取新版本：默认 GitHub 上最新的 Release；--ref <分支或标签>；--from <本地仓库目录>（开发、测试用）
#   2. 备份数据（cmd_backup）+ 快照代码（snapshot：程序目录、服务单元、Caddy 配置、DSH profile）
#   3. 用新版本的 install.sh 原地重装（重装模式不碰账号、令牌、机器清单）
#   4. 健康检查不过：自动恢复快照
# vpssh rollback：恢复最近一次快照（升级前的样子）。
REPO_SLUG="AIcivilization/vpssh"
SNAP_DIR="$ROOT/backups/snapshots"

installed_vpssh() { sed -n 's/.*"vpsshVersion": *"\([^"]*\)".*/\1/p' "$ROOT/state/config.json" 2>/dev/null | head -1; }

# 还没有发布、离线、被限流都返回空（不能让 set -e / pipefail 把调用方整个带走）
latest_release_tag() {
	local json
	json=$(curl -fsSL --max-time 15 "https://api.github.com/repos/$REPO_SLUG/releases/latest" 2>/dev/null) || return 0
	printf '%s' "$json" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1 || true
}

# 快照：升级会改的东西都在里面；DSH 各版本本身按版本号分目录保留，不进快照
snapshot_take() {
	mkdir -p "$SNAP_DIR"
	local file="$SNAP_DIR/snap-$(date +%Y%m%d-%H%M%S).tar.gz" paths=()
	local p
	for p in "$ROOT/bin" "$ROOT/gate" "$ROOT/keyd" "$ROOT/plugin" "$ROOT/dsh/current" \
		"$ROOT/state/config.json" "$ROOT/state/gate.env" \
		/etc/systemd/system/vpssh.service /etc/systemd/system/vpssh-keyd.service \
		/etc/systemd/system/vpssh-upgrade.path /etc/systemd/system/vpssh-upgrade.service \
		/etc/caddy/Caddyfile /etc/caddy/vpssh-site.conf "$DSH_HOME_DIR/profiles"; do
		[[ -e "$p" || -L "$p" ]] && paths+=("${p#/}")
	done
	tar -czf "$file" -C / "${paths[@]}" 2>/dev/null || { local rc=$?; [[ $rc -eq 1 ]] || die "$(M "快照失败（tar 返回 $rc）" "Snapshot failed (tar returned $rc)")"; }
	chmod 600 "$file"
	# 保留最近 3 份
	ls -1t "$SNAP_DIR"/snap-*.tar.gz 2>/dev/null | tail -n +4 | xargs -r rm -f
	printf '%s' "$file"
}

snapshot_restore() { # $1=快照文件
	local file="$1"
	[[ -f "$file" ]] || die "$(M "找不到快照：$file" "Snapshot not found: $file")"
	systemctl stop "$SERVICE" >/dev/null 2>&1 || true
	rm -rf "$ROOT/plugin" "$ROOT/gate" "$ROOT/keyd" "$DSH_HOME_DIR/profiles"
	tar -xzf "$file" -C /
	systemctl daemon-reload
	systemctl restart vpssh-keyd >/dev/null 2>&1 || true
	systemctl reload caddy >/dev/null 2>&1 || systemctl restart caddy >/dev/null 2>&1 || true
	systemctl restart "$SERVICE"
}

wait_healthy() { # $1=最多等多少秒
	local i
	for i in $(seq 1 $(( $1 / 2 ))); do
		curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null | grep -q '"dshCookie":{"authority"' && return 0
		sleep 2
	done
	return 1
}

# 只保留当前和上一个 DSH 版本目录（每个几百 MB）
prune_dsh_versions() {
	local cur keep
	cur=$(current_version)
	keep=$(ls -1t "$ROOT/dsh" 2>/dev/null | grep -vx current | grep -vx "$cur" | head -1 || true)
	local v
	for v in $(ls -1 "$ROOT/dsh" 2>/dev/null | grep -vx current); do
		[[ "$v" == "$cur" || "$v" == "$keep" ]] && continue
		rm -rf "${ROOT:?}/dsh/$v"
		log "$(M "已清理旧的 DSH $v" "Removed old DSH $v")"
	done
}

cmd_upgrade() {
	require_root
	local ref="" from="" yes=0 force=0
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--ref) ref="${2:?--ref}"; shift 2 ;;
		--from) from="${2:?--from}"; shift 2 ;;
		--yes | -y) yes=1; shift ;;
		--force) force=1; shift ;;
		*) die "$(M "未知参数: $1（可用：--ref <分支或标签> --from <目录> --yes --force）" "Unknown option: $1 (available: --ref <branch or tag> --from <dir> --yes --force)")" ;;
		esac
	done

	local src
	src=$(mktemp -d /tmp/vpssh-upgrade.XXXXXX)
	if [[ -n "$from" ]]; then
		[[ -f "$from/server/install.sh" && -f "$from/manifest.json" ]] || die "$(M "$from 不是 vpssh 仓库目录" "$from is not a vpssh repository")"
		(cd "$from" && tar -cf - --exclude=node_modules --exclude=.git --exclude=.sim .) | tar -xf - -C "$src"
	else
		if [[ -z "$ref" ]]; then
			ref=$(latest_release_tag)
			[[ -n "$ref" ]] || die "$(M "查不到 vpssh 的发布版本（离线，或还没有发布）。要升到开发版：sudo vpssh upgrade --ref main" "Could not find a vpssh release (offline, or none published yet). For the development version: sudo vpssh upgrade --ref main")"
		fi
		log "$(M "下载 vpssh（$ref）" "Downloading vpssh ($ref)")"
		curl -fsSL --retry 2 "https://codeload.github.com/$REPO_SLUG/tar.gz/$ref" | tar -xz -C "$src" --strip-components=1 \
			|| die "$(M "下载失败：$ref" "Download failed: $ref")"
	fi
	[[ -f "$src/server/install.sh" && -f "$src/manifest.json" ]] || die "$(M "下载的 vpssh 不完整" "The downloaded vpssh is incomplete")"

	local cur next
	cur=$(installed_vpssh)
	next=$(sed -n 's/^ *"vpssh": *"\([^"]*\)".*/\1/p' "$src/manifest.json" | head -1)
	if [[ -n "$cur" && "$cur" == "$next" && $force -eq 0 ]]; then
		log "$(M "已经是 vpssh $cur，不用升级（要重装同一版本：--force）" "Already on vpssh $cur (to reinstall the same version: --force)")"
		rm -rf "$src"
		return 0
	fi
	if [[ $yes -eq 0 ]]; then
		printf '%s ' "$(M "把 vpssh ${cur:-?} 升级到 ${next:-?}？升级时页面会断开 1–3 分钟，失败会自动回到现在的版本。[y/N]" "Upgrade vpssh ${cur:-?} to ${next:-?}? The page goes away for 1–3 minutes; on failure it returns to the current version. [y/N]")"
		local ans
		read -r ans
		[[ "$ans" =~ ^[Yy] ]] || { rm -rf "$src"; die "$(M "已取消" "Cancelled")"; }
	fi

	cmd_backup
	local snap
	snap=$(snapshot_take)
	log "$(M "已快照：$snap" "Snapshot saved: $snap")"

	local mirror_args=()
	grep -q '"mirror": *"cn"' "$ROOT/state/config.json" 2>/dev/null && mirror_args=(--mirror cn)
	local rc=0
	bash "$src/server/install.sh" "${mirror_args[@]}" || rc=$?
	if [[ $rc -eq 0 ]] && wait_healthy 120; then
		rm -rf "$src"
		prune_dsh_versions
		log "$(M "升级完成：vpssh ${next}" "Upgrade complete: vpssh ${next}")"
		return 0
	fi
	warn "$(M "升级没成功（install.sh 返回 $rc），恢复到升级前…" "The upgrade failed (install.sh returned $rc); restoring the previous version…")"
	snapshot_restore "$snap"
	rm -f "$snap" # 已经回到这个状态了：不留着，下次 rollback 才会回到更早那次升级之前
	rm -rf "$src"
	if wait_healthy 120; then
		warn "$(M "已回到 vpssh ${cur:-之前的版本}，可以照常使用" "Back on vpssh ${cur:-the previous version}; it works as before")"
	else
		warn "$(M "恢复后还没起来：sudo vpssh repair" "Still not up after restoring: sudo vpssh repair")"
	fi
	exit 1
}

cmd_rollback() {
	require_root
	local snap
	snap=$(ls -1t "$SNAP_DIR"/snap-*.tar.gz 2>/dev/null | head -1 || true)
	[[ -n "$snap" ]] || die "$(M "没有可以回滚的快照（升级时才会生成）" "No snapshot to roll back to (one is taken at each upgrade)")"
	log "$(M "恢复快照：$snap" "Restoring snapshot: $snap")"
	snapshot_restore "$snap"
	rm -f "$snap" # 用掉了：再执行一次 rollback 回到更早一次升级之前
	if wait_healthy 120; then
		log "$(M "已回滚：vpssh $(installed_vpssh)" "Rolled back: vpssh $(installed_vpssh)")"
	else
		warn "$(M "回滚后还没起来：sudo vpssh repair" "Not up after the rollback: sudo vpssh repair")"
		exit 1
	fi
}

## endregion

## region: 启动令牌

# 生成一次性令牌并写入 state/setup.token；令牌经 $SETUP_TOKEN 返回。
new_setup_token() {
	local tok
	tok=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)
	if [[ ${#tok} -lt 24 ]]; then
		warn "$(M "启动令牌生成失败，向导将不校验令牌" "Could not create the setup token; the wizard will not check one")"
		SETUP_TOKEN=""
		return 1
	fi
	mkdir -p "$ROOT/state"
	chmod 700 "$ROOT/state"
	printf '%s' "$tok" >"$ROOT/state/setup.token"
	local owner
	owner=$(stat -c %U "$ROOT/state" 2>/dev/null || echo vpssh)
	chown "$owner" "$ROOT/state/setup.token" 2>/dev/null || true
	chmod 600 "$ROOT/state/setup.token"
	SETUP_TOKEN="$tok"
}

# 访问地址：优先 gate.env 的 DSH_TRUSTED_HOST（--trusted-host 的实际取值），回退 config.json
current_host() {
	local host=""
	if [[ -f "$ROOT/state/gate.env" ]]; then
		host=$(sed -n 's/^DSH_TRUSTED_HOST=//p' "$ROOT/state/gate.env" | head -1)
		host=${host%\"}; host=${host#\"}
		host=${host%\'}; host=${host#\'}
	fi
	if [[ -z "$host" && -f "$ROOT/state/config.json" ]]; then
		host=$(sed -n 's/.*"domain"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/state/config.json" | head -1)
	fi
	printf '%s' "$host"
}

cmd_setup_url() {
	require_root
	local host token=""
	host=$(current_host)
	[[ -n "$host" ]] || die "$(M "无法确定访问地址（$ROOT/state/gate.env 缺失）；可手工拼接 https://<你的域名>/setup?token=<令牌>" "Cannot tell the address ($ROOT/state/gate.env is missing); build it by hand: https://<your domain>/setup?token=<token>")"
	[[ -f "$ROOT/state/setup.token" ]] && token=$(tr -d '[:space:]' <"$ROOT/state/setup.token")
	if [[ -z "$token" ]]; then
		if [[ -f "$ROOT/state/setup.lock" ]]; then
			log "$(M "初始设置已完成，无需令牌。直接打开 https://$host 登录。" "Setup is already done; no token needed. Open https://$host and sign in.")"
		else
			warn "$(M "未找到启动令牌（$ROOT/state/setup.token），向导当前不校验令牌；直接打开 https://$host 设置。" "No setup token ($ROOT/state/setup.token); the wizard does not check one. Open https://$host to set up.")"
		fi
		return 0
	fi
	log "$(M "初始设置链接（令牌一次性，设置完成后自动失效）：" "Setup link (one-time token, stops working once setup is done):")"
	echo "  https://$host/setup?token=$token"
}

## endregion

## region: reset-admin

cmd_reset_admin() {
	require_root
	local assume_yes=0
	[[ "${1:-}" == "--yes" ]] && assume_yes=1
	if [[ $assume_yes -eq 0 ]]; then
		warn "$(M "将删除管理员账号与向导锁（admin.json + setup.lock），之后需重新走浏览器向导。" "This deletes the admin account and the setup lock (admin.json + setup.lock); you then run the browser setup again.")"
		read -rp "$(M "确认继续？[y/N] " "Continue? [y/N] ")" ans
		[[ "$ans" == "y" || "$ans" == "Y" ]] || die "$(M "已取消" "Cancelled")"
	fi
	rm -f "$ROOT/state/admin.json" "$ROOT/state/setup.lock"
	# 重开向导等于重新暴露 /setup：必须换发令牌，否则旧令牌（可能已泄露）仍然有效
	new_setup_token || true
	log "$(M "已重置，并已换发启动令牌。" "Reset; a new setup token was issued.")"
	cmd_setup_url
}

## endregion

## region: restart

cmd_restart() {
	require_root
	systemctl restart "$SERVICE"
	log "$(M "已重启 ${SERVICE}（DSH 子进程将自动重启并重新兑换会话）" "Restarted ${SERVICE}")"
}

## endregion

## region: repair

# 命令行文字跟系统语言：zh 开头用中文，否则英文。写法：M '中文' 'English'
M() { case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in zh*) printf '%s' "$1" ;; *) printf '%s' "$2" ;; esac; }

# 网页打不开时的救援：SSH 上来执行一条命令，把 vpssh 的入口恢复到能用。
# 只做"让入口回来"的事，不动用户数据：
#   1. 拉起 vpssh-keyd、本机 SSH、Caddy、vpssh 这几个服务（开机自启也补上）
#   2. 按当前设置重写 Caddy 站点（--public：先关掉「仅我的设备」，重新对公网开放）
#   3. 重新打上设置页补丁（ownsHost）
#   4. ufw 开着时放行 80/443 和本机 SSH 端口
#   5. 等健康检查，打印访问地址；还不行就给出该看哪几行日志
cmd_repair() {
	require_root
	local public=0 arg
	for arg in "$@"; do
		case "$arg" in
		--public) public=1 ;;
		*) die "$(M "未知参数: $arg（可用：--public）" "Unknown option: $arg (available: --public)")" ;;
		esac
	done
	log "$(M "vpssh 救援：恢复网页入口" "vpssh repair: restoring the web entrance")"

	local svc ssh_svc="ssh" failed=()
	if [[ $public -eq 1 && "$(vpn_env)" == "on" ]]; then
		vpn_set_mode off
		log "$(M "已关闭「仅我的设备可访问」，重新对公网开放（登录照样要账号密码）" "Turned off 'only my devices'; the site is public again (sign-in is still required)")"
	elif [[ "$(vpn_env)" == "on" ]]; then
		log "$(M "当前是「仅我的设备可访问」：没连 WireGuard 的设备打不开。要对公网开放：sudo vpssh repair --public" "Access is limited to your WireGuard devices. To open it to the internet again: sudo vpssh repair --public")"
	fi
	vpn_apply_site
	log "$(M "Caddy 站点已按当前设置重写" "Rewrote the Caddy site from the current settings")"

	systemctl list-unit-files ssh.service >/dev/null 2>&1 || ssh_svc="sshd"
	# 先写站点再起 Caddy：站点文件缺了 Caddy 根本起不来
	for svc in vpssh-keyd "$ssh_svc" caddy "$SERVICE"; do
		systemctl enable "$svc" >/dev/null 2>&1 || true
		if systemctl is-active --quiet "$svc"; then
			[[ "$svc" == "$SERVICE" ]] || continue
		fi
		if systemctl restart "$svc" >/dev/null 2>&1 && systemctl is-active --quiet "$svc"; then
			log "$(M "已启动 $svc" "Started $svc")"
		else
			failed+=("$svc")
			warn "$(M "$svc 起不来：journalctl -u $svc -n 30" "$svc does not start: journalctl -u $svc -n 30")"
		fi
	done

	cmd_ownshost on >/dev/null 2>&1 || warn "$(M "设置页补丁没打上：sudo vpssh ownshost on" "Could not re-apply the settings patch: sudo vpssh ownshost on")"

	if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "^Status: active"; then
		local port
		port=$(sshd -T 2>/dev/null | awk '$1=="port"{print $2; exit}')
		local pub
		pub=$(sed -n 's/.*"publicPort": *\([0-9]*\).*/\1/p' "$ROOT/state/config.json" 2>/dev/null | head -1)
		pub="${pub:-443}"
		ufw allow 80/tcp >/dev/null; ufw allow "$pub/tcp" >/dev/null; ufw allow "${port:-22}/tcp" >/dev/null
		log "$(M "ufw 已放行 80、$pub、${port:-22}" "ufw now allows 80, $pub and ${port:-22}")"
	fi

	local i ok=0 body
	for i in $(seq 1 45); do
		body=$(curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null) || { sleep 2; continue; }
		if printf '%s' "$body" | grep -q '"dshCookie":{"authority"'; then ok=1; break; fi
		sleep 2
	done
	echo
	if [[ $ok -eq 1 && ${#failed[@]} -eq 0 ]]; then
		log "$(M "好了，浏览器打开：https://$(current_host)" "Done. Open in your browser: https://$(current_host)")"
		[[ -f "$ROOT/state/setup.lock" ]] || log "$(M "初始设置还没完成，设置链接：sudo vpssh setup-url" "Setup is not finished yet; get the link with: sudo vpssh setup-url")"
	else
		warn "$(M "还没恢复。把下面几条的输出发给我们（反馈：https://github.com/AIcivilization/vpssh/issues）：" "Not restored yet. Send us the output of these (https://github.com/AIcivilization/vpssh/issues):")"
		echo "  sudo vpssh status"
		echo "  journalctl -u $SERVICE -n 80 --no-pager"
		echo "  journalctl -u caddy -n 30 --no-pager"
		exit 1
	fi
}

## endregion

## region: ownshost

# 公网域名下 DSH 前端按 location.hostname 判定 connection.isLoopback=false，
# 设置镜像随即退化为 memory 持久化，设置页报"设置在此浏览器中不可用"，
# 填 Key、改权限全部废掉。官方预留的 __DSH_TRANSPORT__.ownsHost 声明可解除
# 该判定（dsh-client-connection: isLoopback = transport?.ownsHost === true || ...）。
#
# 早先走的是 gate 代理改写 HTML，已经证明太脆：压缩响应、304、超大 body
# 任意一个条件不满足就静默失效，且外部完全看不出来。改为直接写前端静态文件：
# dsh-host-frontend-static 对每个 index 响应都 readFile(dist/index.html)，
# 改完即刻生效，不依赖代理、不怕缓存、不怕压缩。
ownshost_index() { echo "$ROOT/dsh/current/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html"; }

ownshost_apply() { # $1=on|off；stdout: patched / present / off
	local mode="${1:-on}"
	local idx
	idx=$(ownshost_index)
	if [[ ! -f "$idx" ]]; then
		warn "$(M "未找到前端 index.html（${idx}），跳过 ownsHost 补丁" "Frontend index.html not found (${idx}); skipping the settings patch")"
		return 1
	fi
	local tmp rc=0
	tmp=$(mktemp "${TMPDIR:-/tmp}/vpssh-ownshost.XXXXXX.cjs")
	cat >"$tmp" <<'NODE'
const fs = require("fs");
const [file, mode] = process.argv.slice(2);
const MARK = "vpssh:ownshost";
const SNIPPET =
	'<script data-vpssh="ownshost">/* ' + MARK +
	" */window.__DSH_TRANSPORT__=Object.assign(window.__DSH_TRANSPORT__||{},{ownsHost:true});</script>";
// 升级提示条：同源脚本，由 gate 提供（/gate/ui.js）
const UI_MARK = "vpssh:ui";
const UI_SNIPPET = '<script data-vpssh="' + UI_MARK + '" src="/gate/ui.js" defer></script>';
// 添加到手机桌面：iPhone 用的 PNG 图标与桌面上的名字（与 gate/server.js 的 HOME_SCREEN_TAGS 一致）
const ICON_MARK = "vpssh:icon";
const ICON_SNIPPET =
	'<link rel="apple-touch-icon" href="/gate/apple-touch-icon.png" data-vpssh="' + ICON_MARK + '">' +
	'<meta name="apple-mobile-web-app-title" content="DSH">' +
	'<meta name="apple-mobile-web-app-capable" content="yes">' +
	'<meta name="mobile-web-app-capable" content="yes">';
let s = fs.readFileSync(file, "utf8");
const orig = file + ".orig";
if (mode === "off") {
	if (fs.existsSync(orig)) fs.copyFileSync(orig, file);
	else fs.writeFileSync(file, s.split("\n").filter((l) => !l.includes(MARK) && !l.includes(UI_MARK) && !l.includes(ICON_MARK)).join("\n"));
	console.log("off");
	process.exit(0);
}
const missing = [];
if (!s.includes(MARK)) missing.push(SNIPPET);
if (!s.includes(UI_MARK)) missing.push(UI_SNIPPET);
if (!s.includes(ICON_MARK)) missing.push(ICON_SNIPPET);
if (missing.length === 0) {
	console.log("present");
	process.exit(0);
}
if (!fs.existsSync(orig)) fs.copyFileSync(file, orig);
const m = s.match(/<head(?:\s[^>]*)?>/i);
if (m === null) {
	console.error("no <head> found in " + file);
	process.exit(1);
}
const at = m.index + m[0].length;
fs.writeFileSync(file, s.slice(0, at) + missing.map((x) => "\n    " + x).join("") + s.slice(at));
console.log("patched");
NODE
	node "$tmp" "$idx" "$mode" || rc=$?
	rm -f "$tmp"
	return $rc
}

cmd_ownshost() {
	local mode="${1:-status}"
	local idx
	idx=$(ownshost_index)
	case "$mode" in
	on)
		require_root
		local out
		out=$(ownshost_apply on) || { warn "$(M "ownsHost 补丁失败（见上方错误）" "Settings patch failed (see the error above)")"; return 1; }
		if [[ "$out" == "patched" ]]; then
			log "$(M "已写入 ownsHost 声明（原件备份为 index.html.orig）" "Settings patch applied (original kept as index.html.orig)")"
			log "$(M "无需重启：DSH 每次响应都重新读取该文件。浏览器硬刷新一次即可。" "No restart needed; reload the page once in the browser.")"
		else
			log "$(M "ownsHost 声明已存在，无需重复写入" "Settings patch already applied")"
		fi
		;;
	off)
		require_root
		ownshost_apply off >/dev/null || { warn "$(M "撤销失败" "Could not remove it")"; return 1; }
		log "$(M "已撤销 ownsHost 声明（设置页回到官方默认的不可用状态）" "Settings patch removed (settings go back to DSH's default)")"
		;;
	status)
		if [[ ! -f "$idx" ]]; then
			echo "$(M "  ownsHost 补丁: 未找到 $idx" "  settings patch: $idx not found")"
			return 1
		fi
		if VPSSH_IDX="$idx" node -e 'process.exit(require("fs").readFileSync(process.env.VPSSH_IDX,"utf8").includes("vpssh:ownshost")?0:1)'; then
			echo "$(M "  ownsHost 补丁: 已生效" "  settings patch: applied")"
		else
			echo "$(M "  ownsHost 补丁: 未生效 → sudo vpssh ownshost on" "  settings patch: not applied → sudo vpssh ownshost on")"
		fi
		;;
	*) die "$(M "用法: vpssh ownshost [on|off|status]" "Usage: vpssh ownshost [on|off|status]")" ;;
	esac
}

## endregion

## region: 仅我可访问

# 两种办法，目标一致：让公网访问不到登录页。
#
#   1) vpn    WireGuard 自建隧道。给每台设备发一个我们分配的隧道地址（10.7.0.x），
#             服务端只放行这个网段。出口 IP 怎么变都不影响——它根本不参与判断。
#   2) tunnel SSH 本地端口转发。零安装，适合只在电脑上用的场景。
#
# 不做公网出口 IP 白名单：出口 IP 不是身份，换网络 / 宽带重拨就变，会把使用者
# 自己关在门外。隧道地址由我们分配，永不变化。
#
# 分离隧道：不开 ip_forward、不做 NAT。这台机器只提供 DSH 访问通道，不是全流量 VPN。

VPN_IF="wg0"
VPN_SUBNET_DEFAULT="10.7.0.0/24"
VPN_PORT_DEFAULT=51820
VPN_DIR="$ROOT/state/vpn"     # 服务端密钥 + 每台设备的记录与客户端配置
VPN_ENV="$ROOT/state/vpn.env" # VPSSH_VPN=on|off / VPSSH_VPN_SUBNET
WG_DIR="/etc/wireguard"
WG_CONF="$WG_DIR/$VPN_IF.conf"

vpn_env() { # 输出 on|off
	if [[ -f "$VPN_ENV" ]] && grep -qx 'VPSSH_VPN=on' "$VPN_ENV"; then
		printf 'on'
	else
		printf 'off'
	fi
}

vpn_subnet() {
	local s=""
	[[ -f "$VPN_ENV" ]] && s=$(sed -n 's/^VPSSH_VPN_SUBNET=//p' "$VPN_ENV" | head -1)
	printf '%s' "${s:-$VPN_SUBNET_DEFAULT}"
}

vpn_listen_port() {
	local p=""
	[[ -f "$WG_CONF" ]] && p=$(sed -n 's/^[[:space:]]*ListenPort[[:space:]]*=[[:space:]]*//p' "$WG_CONF" | head -1)
	printf '%s' "${p:-$VPN_PORT_DEFAULT}"
}

# state/ 属主通常是 vpssh（gate 运行身份）。vpn.env 由 root 写入后要交还属主，
# 否则向导改域名时 gate 读不到，隧道策略会被静默丢掉。
vpn_state_owner() { stat -c %U "$ROOT/state" 2>/dev/null || echo vpssh; }

vpn_set_mode() { # $1=on|off
	local mode="$1" owner
	owner=$(vpn_state_owner)
	mkdir -p "$ROOT/state"
	printf 'VPSSH_VPN=%s\nVPSSH_VPN_SUBNET=%s\n' "$mode" "$(vpn_subnet)" >"$VPN_ENV"
	chown "$owner" "$VPN_ENV" 2>/dev/null || true
	chmod 600 "$VPN_ENV"
}

site_block_js() {
	if [[ ! -f "$ROOT/gate/site-block.js" ]]; then
		log "$(M "缺少 gate/site-block.js，拉取一份..." "gate/site-block.js is missing; downloading it...")"
		curl -fsSL --max-time 30 "$RAW_BASE/gate/site-block.js" -o "$ROOT/gate/site-block.js" \
			|| die "$(M "拉取失败（离线？可稍后运行: sudo vpssh update-gate）" "Download failed (offline? later run: sudo vpssh repair)")"
		chmod 644 "$ROOT/gate/site-block.js"
	fi
	printf '%s' "$ROOT/gate/site-block.js"
}

# 重写 Caddy 站点块并热加载。root 运行，直接 systemctl reload，不必绕 admin API。
vpn_apply_site() {
	require_root
	local host js
	host=$(current_host)
	[[ -n "$host" ]] || die "$(M "无法确定站点地址（$ROOT/state/gate.env 缺失）" "Cannot tell the site address ($ROOT/state/gate.env is missing)")"
	js=$(site_block_js)
	node "$js" "$host" "$ROOT" "$GATE_PORT" >/etc/caddy/vpssh-site.conf || die "$(M "生成站点块失败" "Generating the site config failed")"
	chown "$(vpn_state_owner)":caddy /etc/caddy/vpssh-site.conf 2>/dev/null || true
	chmod 640 /etc/caddy/vpssh-site.conf
	systemctl reload caddy >/dev/null 2>&1 || systemctl restart caddy >/dev/null 2>&1 || true
}

vpn_endpoint_host() { # 客户端 Endpoint 用的主机名：域名优先，其次公网 IP
	local h
	h=$(current_host)
	if [[ -z "$h" ]]; then
		h=$(curl -4 -fsSL --max-time 5 https://api.ipify.org 2>/dev/null | tr -d '[:space:]' || true)
	fi
	[[ -n "$h" ]] || h=$(hostname -I 2>/dev/null | awk '{print $1}')
	printf '%s' "$h"
}

vpn_next_ip() { # 输出下一个未占用的隧道地址（如 10.7.0.2）
	local subnet prefix last=1 f addr oct
	subnet=$(vpn_subnet)
	prefix="${subnet%.*}."
	for f in "$VPN_DIR"/peers/*.env; do
		[[ -f "$f" ]] || continue
		addr=$(sed -n 's/^ADDRESS=//p' "$f" | head -1)
		addr=${addr%/*}
		oct=${addr##*.}
		if [[ "$oct" =~ ^[0-9]+$ ]] && ((oct > last)); then last=$oct; fi
	done
	printf '%s%s' "$prefix" "$((last + 1))"
}

# 增量同步给内核，不重启接口（重启会掐掉已连着的设备）
vpn_wg_syncconf() {
	wg syncconf "$VPN_IF" <(wg-quick strip "$WG_CONF") \
		|| die "$(M "同步隧道配置失败（wg syncconf）；可尝试 systemctl restart wg-quick@$VPN_IF" "Could not sync the tunnel config (wg syncconf); try systemctl restart wg-quick@$VPN_IF")"
}

vpn_conf_drop_peer() { # $1=名字：按注释标记整段移除 [Peer]
	local tmp
	tmp=$(mktemp "${TMPDIR:-/tmp}/vpssh-wg.XXXXXX")
	awk -v want="# vpssh peer: $1" '
		/^\[/ { flush() }
		{ buf[++n] = $0 }
		END { flush() }
		function flush(   i, keep) {
			if (n == 0) return
			keep = 1
			for (i = 1; i <= n; i++) if (index(buf[i], want) > 0) keep = 0
			if (keep) for (i = 1; i <= n; i++) print buf[i]
			n = 0
		}
	' "$WG_CONF" >"$tmp"
	mv "$tmp" "$WG_CONF"
	chmod 600 "$WG_CONF"
}

vpn_peer_conf() { # $1=名字 $2=地址 $3=客户端私钥 $4=服务端公钥
	local subnet
	subnet=$(vpn_subnet)
	cat <<EOF
# vpssh 客户端配置 · $1
# 分离隧道：只有访问 $subnet 会走这台 VPS，其余流量照常走本地网络。
[Interface]
PrivateKey = $3
Address = $2/32

[Peer]
PublicKey = $4
Endpoint = $(vpn_endpoint_host):$(vpn_listen_port)
AllowedIPs = $subnet
PersistentKeepalive = 25
EOF
}

vpn_show_conf() { # $1=名字 $2=配置文件路径
	local conf="$2"
	echo
	echo "------------------------------------------------------------"
	echo "$(M " 设备 $1 的客户端配置（同时保存在 ${conf}）" " Client config for $1 (also saved to ${conf})")"
	echo "------------------------------------------------------------"
	cat "$conf"
	echo "------------------------------------------------------------"
	if command -v qrencode >/dev/null 2>&1; then
		echo "$(M " 手机 WireGuard App 扫码导入：" " Scan with the WireGuard app on your phone:")"
		qrencode -t ansiutf8 -r "$conf"
	else
		warn "$(M "未装 qrencode，想扫码导入可：apt-get install -y qrencode" "qrencode is not installed; for a QR code: apt-get install -y qrencode")"
	fi
}

cmd_vpn_add() {
	require_root
	local name="${1:-}"
	[[ -n "$name" ]] || die "$(M "用法: sudo vpssh vpn add <设备名>   例：sudo vpssh vpn add macbook" "Usage: sudo vpssh vpn add <device>   e.g. sudo vpssh vpn add macbook")"
	[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "$(M "设备名只能用字母、数字、-、_：$name" "Device names may only use letters, digits, - and _: $name")"
	[[ -d "$VPN_DIR" ]] || die "$(M "尚未初始化隧道：sudo vpssh vpn setup" "The tunnel is not set up: sudo vpssh vpn setup")"
	[[ -f "$VPN_DIR/peers/$name.env" ]] && die "$(M "设备已存在：${name}（先 sudo vpssh vpn revoke ${name}）" "Device exists: ${name} (first: sudo vpssh vpn revoke ${name})")"

	local srv_pub ip priv pub
	srv_pub=$(tr -d '[:space:]' <"$VPN_DIR/server.pub")
	ip=$(vpn_next_ip)
	mkdir -p "$VPN_DIR/peers"
	chmod 700 "$VPN_DIR" "$VPN_DIR/peers"
	priv=$(wg genkey)
	pub=$(printf '%s' "$priv" | wg pubkey)

	printf 'ADDRESS=%s/32\nPUBLIC_KEY=%s\nCREATED_AT=%s\n' \
		"$ip" "$pub" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$VPN_DIR/peers/$name.env"
	chmod 600 "$VPN_DIR/peers/$name.env"

	# 名字标记写在 [Peer] 之后：吊销时按「从上一个 [ 到下一个 [ 之前」整段删除，
	# 标记若在 [Peer] 之前会被算进上一段，删错对象。
	printf '\n[Peer]\n# vpssh peer: %s\nPublicKey = %s\nAllowedIPs = %s/32\n' \
		"$name" "$pub" "$ip" >>"$WG_CONF"
	vpn_wg_syncconf

	local conf="$VPN_DIR/peers/$name.conf"
	vpn_peer_conf "$name" "$ip" "$priv" "$srv_pub" >"$conf"
	chmod 600 "$conf"
	vpn_show_conf "$name" "$conf"
	log "$(M "隧道地址 ${ip}（含私钥，$conf 权限 600；丢了就 revoke 后重新签发）" "Tunnel address ${ip} (contains a private key; $conf is mode 600; if lost, revoke and add again)")"
}

cmd_vpn_revoke() {
	require_root
	local name="${1:-}"
	[[ -n "$name" ]] || die "$(M "用法: sudo vpssh vpn revoke <设备名>" "Usage: sudo vpssh vpn revoke <device>")"
	[[ -f "$VPN_DIR/peers/$name.env" ]] || die "$(M "没有这台设备：$name" "No such device: $name")"
	vpn_conf_drop_peer "$name"
	rm -f "$VPN_DIR/peers/$name.env" "$VPN_DIR/peers/$name.conf"
	vpn_wg_syncconf
	log "$(M "已吊销 ${name}（它的隧道立即失效）" "Revoked ${name} (its tunnel stops working now)")"
}

cmd_vpn_list() {
	# 中文标题按字节算宽度，用 %-Ns 对齐反而错位，交给制表符
	printf '  设备\t隧道地址\t最近握手\n'
	local found=0 handshakes="" f
	if command -v wg >/dev/null 2>&1; then
		handshakes=$(wg show "$VPN_IF" latest-handshakes 2>/dev/null || true)
	fi
	for f in "$VPN_DIR"/peers/*.env; do
		[[ -f "$f" ]] || continue
		found=1
		local name addr pub hs when="从未"
		name=$(basename "$f" .env)
		addr=$(sed -n 's/^ADDRESS=//p' "$f" | head -1)
		pub=$(sed -n 's/^PUBLIC_KEY=//p' "$f" | head -1)
		hs=$(printf '%s\n' "$handshakes" | awk -v k="$pub" '$1==k {print $2; exit}')
		if [[ -n "$hs" && "$hs" != "0" ]]; then
			when=$(date -d "@$hs" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$hs")
		fi
		printf '  %s\t%s\t%s\n' "$name" "$addr" "$when"
	done
	[[ $found -eq 1 ]] || echo "$(M "  （还没有签发设备：sudo vpssh vpn add <名字>）" "  (no devices yet: sudo vpssh vpn add <name>)")"
}

cmd_vpn_status() {
	echo "$(M "== 访问策略 ==" "== Access ==")"
	if [[ "$(vpn_env)" == "on" ]]; then
		echo "$(M "  仅隧道可访问：Caddy 只放行 $(vpn_subnet)，其他来源直接断连" "  Tunnel only: Caddy accepts $(vpn_subnet) and drops everything else")"
	else
		echo "$(M "  公网可访问：任何来源都能打开登录页（凭用户名密码）" "  Public: anyone can reach the sign-in page (behind the password)")"
	fi
	echo
	echo "$(M "== 隧道接口 ==" "== Tunnel ==")"
	if [[ -d "/sys/class/net/$VPN_IF" ]]; then
		echo "$(M "  $VPN_IF 已启用（监听 UDP $(vpn_listen_port)）" "  $VPN_IF is up (UDP $(vpn_listen_port))")"
		wg show "$VPN_IF" 2>/dev/null | sed 's/^/  /'
	else
		echo "$(M "  $VPN_IF 未启用（sudo vpssh vpn setup）" "  $VPN_IF is not set up (sudo vpssh vpn setup)")"
	fi
	echo
	echo "$(M "== 已签发设备 ==" "== Devices ==")"
	cmd_vpn_list
}

cmd_vpn_mode() {
	local mode="${1:-}"
	[[ "$mode" == "on" || "$mode" == "off" ]] || die "$(M "用法: sudo vpssh vpn on|off" "Usage: sudo vpssh vpn on|off")"
	require_root
	if [[ "$mode" == "on" && ! -f "$WG_CONF" ]]; then
		die "$(M "隧道还没建：sudo vpssh vpn setup" "The tunnel is not set up: sudo vpssh vpn setup")"
	fi
	vpn_set_mode "$mode"
	vpn_apply_site
	if [[ "$mode" == "on" ]]; then
		log "$(M "已切为「仅隧道可访问」：公网打不开登录页，隧道里的设备照常访问" "Switched to tunnel only: the sign-in page is closed to the internet; tunnel devices work as before")"
	else
		log "$(M "已切为「公网可访问」：隧道还能继续用，只是不再强制" "Switched to public: the tunnel still works but is no longer required")"
	fi
}

cmd_vpn_setup() {
	require_root
	local name="${1:-device1}"
	local subnet port addr srv_pub
	subnet=$(vpn_subnet)
	port=$VPN_PORT_DEFAULT

	if ! command -v wg >/dev/null 2>&1; then
		log "$(M "安装 WireGuard..." "Installing WireGuard...")"
		apt-get update -y >/dev/null
		apt-get install -y wireguard >/dev/null || die "$(M "WireGuard 安装失败" "Installing WireGuard failed")"
	fi

	mkdir -p "$VPN_DIR/peers"
	chmod 700 "$VPN_DIR" "$VPN_DIR/peers"

	# 服务端密钥只生成一次：重跑 setup 不换密钥，已签发的设备不受影响
	if [[ ! -f "$VPN_DIR/server.key" ]]; then
		(umask 077 && wg genkey >"$VPN_DIR/server.key")
		chmod 600 "$VPN_DIR/server.key"
	fi
	wg pubkey <"$VPN_DIR/server.key" >"$VPN_DIR/server.pub"
	srv_pub=$(tr -d '[:space:]' <"$VPN_DIR/server.pub")

	addr="${subnet%.*}.1"
	if [[ ! -f "$WG_CONF" ]]; then
		mkdir -p "$WG_DIR"
		chmod 700 "$WG_DIR"
		cat >"$WG_CONF" <<EOF
# vpssh 隧道接口：给这台机器上的 DSH 开一条私有通道。
# 分离隧道——不开 IP 转发、不做 NAT。它不是全流量 VPN，只服务 DSH。
[Interface]
Address = $addr/24
ListenPort = $port
PrivateKey = $(tr -d '[:space:]' <"$VPN_DIR/server.key")
SaveConfig = false
EOF
		chmod 600 "$WG_CONF"
	elif ! grep -q "vpssh" "$WG_CONF"; then
		# 不接管别人的 wg0：往里追加设备会改掉你原有的隧道，卸载时也分不清该不该删
		die "$(M "${WG_CONF} 已存在且不是 vpssh 创建的（你自己的 WireGuard？）。为避免改动它，本命令已停止。" "${WG_CONF} exists and was not created by vpssh (your own WireGuard?). Stopped so it is not changed.")"
	else
		log "$(M "已有 ${WG_CONF}，保留接口与已签发的设备" "${WG_CONF} exists; keeping the interface and its devices")"
	fi

	systemctl enable --now "wg-quick@$VPN_IF" >/dev/null 2>&1 \
		|| die "$(M "启动 wg-quick@$VPN_IF 失败：journalctl -u wg-quick@$VPN_IF -n 50" "Could not start wg-quick@$VPN_IF: journalctl -u wg-quick@$VPN_IF -n 50")"

	if command -v ufw >/dev/null 2>&1; then
		ufw allow "$port"/udp >/dev/null && log "$(M "ufw 已放行 $port/udp" "ufw now allows $port/udp")"
	fi

	vpn_set_mode on
	vpn_apply_site
	log "$(M "已切为「仅隧道可访问」：公网访问登录页会直接断连" "Switched to tunnel only: internet connections to the sign-in page are dropped")"

	cmd_vpn_add "$name"

	echo
	echo "============================================================"
	echo "$(M " 隧道已就绪" " The tunnel is ready")"
	echo "------------------------------------------------------------"
	echo "$(M " 服务端隧道地址 : ${addr}（网段 ${subnet}）" " Server tunnel address: ${addr} (subnet ${subnet})")"
	echo "$(M " 监听           : UDP $port" " Listening on   : UDP $port")"
	echo "------------------------------------------------------------"
	echo "$(M " 1. 云厂商安全组放行 UDP ${port}（多数连不上都是卡在这一步）" " 1. Allow UDP ${port} in your provider's firewall (the usual cause when it does not connect)")"
	echo "$(M " 2. 设备装 WireGuard 官方 App，导入上面这份配置" " 2. Install the official WireGuard app on the device and import the config above")"
	echo "$(M " 3. 连上后访问 https://$(vpn_endpoint_host)" " 3. Once connected, open https://$(vpn_endpoint_host)")"
	echo "------------------------------------------------------------"
	echo "$(M " 隧道连不上或设备丢了？SSH 登录后：sudo vpssh vpn off" " Tunnel broken or device lost? Over SSH: sudo vpssh vpn off")"
	echo "$(M " （公网立即恢复，隧道配置原样保留，修好再 vpn on）" " (public access comes back at once; the tunnel config stays, vpn on when fixed)")"
	echo "$(M " 临时访问不想装东西：sudo vpssh tunnel（SSH 本地转发）" " Quick access without installing anything: sudo vpssh tunnel (SSH port forwarding)")"
	echo "============================================================"
}

cmd_vpn() {
	local sub="${1:-status}"
	shift || true
	case "$sub" in
	setup) cmd_vpn_setup "$@" ;;
	add) cmd_vpn_add "$@" ;;
	revoke) cmd_vpn_revoke "$@" ;;
	list) cmd_vpn_list "$@" ;;
	status) cmd_vpn_status "$@" ;;
	on) cmd_vpn_mode on ;;
	off) cmd_vpn_mode off ;;
	-h | --help) cmd_vpn_help ;;
	*) cmd_vpn_help; die "$(M "未知动作: $sub" "Unknown action: $sub")" ;;
	esac
}

cmd_vpn_help() {
	if [[ "$(M zh en)" != zh ]]; then
		cat <<'EOF'
Usage: sudo vpssh vpn <action>
  setup [name]   Install WireGuard, create the tunnel, issue the first device, and switch to tunnel-only access
  add <name>     Issue another device (prints its config and a QR code)
  revoke <name>  Revoke a device; it stops working at once
  list           Devices and their last handshake
  status         Access mode, tunnel status, devices
  on | off       Switch between tunnel-only and public access
EOF
		return
	fi
	cat <<'EOF'
用法: sudo vpssh vpn <动作>
  setup [名字]   安装 WireGuard、建隧道、签发第一台设备，并切到「仅隧道可访问」
  add <名字>     再签发一台设备（打印配置与二维码）
  revoke <名字>  吊销设备，立即失效
  list           列出设备与最近握手时间
  status         访问策略 + 隧道状态 + 设备
  on | off       切换「仅隧道可访问」/「公网可访问」
EOF
}

cmd_tunnel() {
	local host
	host=$(vpn_endpoint_host)
	if [[ "$(M zh en)" != zh ]]; then
		cat <<EOF
No-install option: SSH local port forwarding. Nothing to install, and still only you can reach vpssh.

  1. On your computer, keep a window open running (closing it ends the tunnel):
       ssh -N -L $GATE_PORT:127.0.0.1:$GATE_PORT root@$host

  2. Open in the browser:
       http://127.0.0.1:$GATE_PORT

Or put this in ~/.ssh/config:

  Host vpssh
    HostName $host
    User root
    LocalForward $GATE_PORT 127.0.0.1:$GATE_PORT
    ServerAliveInterval 30

then just: ssh -N vpssh

Notes:
  · Only your local port $GATE_PORT is forwarded to the same port on the server; it ends when you disconnect
  · The public entrance stays open (to close it: sudo vpssh vpn setup)
  · Phones cannot do this; for always-on access use the WireGuard tunnel
EOF
		return
	fi
	cat <<EOF
零安装方案：SSH 本地端口转发。不装任何东西，效果同样是「只有你能访问 DSH」。

  1. 本机开一个窗口执行（关掉窗口隧道就没了）：
       ssh -N -L $GATE_PORT:127.0.0.1:$GATE_PORT root@$host

  2. 浏览器打开：
       http://127.0.0.1:$GATE_PORT

写进 ~/.ssh/config 之后一条命令：

  Host vpssh
    HostName $host
    User root
    LocalForward $GATE_PORT 127.0.0.1:$GATE_PORT
    ServerAliveInterval 30

之后只要：ssh -N vpssh

说明：
  · 只把本机 $GATE_PORT 转发到服务器上同样的端口；断开即失效
  · 公网那扇门仍然开着（要彻底关上用 sudo vpssh vpn setup）
  · 手机用不了这种方式，要常连就用 WireGuard 隧道
EOF
}

## endregion

## region: 浏览器一键升级

# 页面上点「立即升级」→ gate（vpssh 用户，无特权）只写 state/upgrade.request →
# systemd path 单元看到文件 → 以 root 跑 vpssh upgrade-run。网页拿不到 root，
# 能触发的只有这一条固定命令：升级到 npm 官方 latest（备份 → 自检 → 失败自动回滚）。
UPGRADE_REQUEST="$ROOT/state/upgrade.request"
UPGRADE_STATUS="$ROOT/state/upgrade.status.json"
UPGRADE_LOG="$ROOT/state/upgrade.log"
UNINSTALL_REQUEST="$ROOT/state/uninstall.request"

cmd_install_units() {
	require_root
	cat >/etc/systemd/system/vpssh-upgrade.path <<UNIT
# vpssh：监听浏览器发起的 DSH 升级请求（由 vpssh install-units 生成）
[Unit]
Description=vpssh: watch for browser-initiated DSH upgrade requests

[Path]
PathExists=$UPGRADE_REQUEST
Unit=vpssh-upgrade.service

[Install]
WantedBy=multi-user.target
UNIT
	cat >/etc/systemd/system/vpssh-upgrade.service <<UNIT
# vpssh：执行浏览器发起的 DSH 升级（由 vpssh install-units 生成）
[Unit]
Description=vpssh: run a DSH upgrade requested from the browser

[Service]
Type=oneshot
ExecStart=$ROOT/bin/vpssh upgrade-run
TimeoutStartSec=30min
UNIT
	cat >/etc/systemd/system/vpssh-uninstall.path <<UNIT
# vpssh：监听网页上的卸载请求（由 vpssh install-units 生成；gate 核对过管理员密码才会写这个文件）
[Unit]
Description=vpssh: watch for an uninstall request from the browser

[Path]
PathExists=$UNINSTALL_REQUEST
Unit=vpssh-uninstall.service

[Install]
WantedBy=multi-user.target
UNIT
	cat >/etc/systemd/system/vpssh-uninstall.service <<UNIT
# vpssh：执行网页上发起的卸载（由 vpssh install-units 生成）
[Unit]
Description=vpssh: uninstall, as requested from the browser

[Service]
Type=oneshot
ExecStart=$ROOT/bin/vpssh uninstall-run
TimeoutStartSec=15min
UNIT
	systemctl daemon-reload
	systemctl enable --now vpssh-upgrade.path >/dev/null 2>&1 || die "$(M "启用 vpssh-upgrade.path 失败" "Could not enable vpssh-upgrade.path")"
	systemctl enable --now vpssh-uninstall.path >/dev/null 2>&1 || die "$(M "启用 vpssh-uninstall.path 失败" "Could not enable vpssh-uninstall.path")"
	log "$(M "浏览器一键升级、网页卸载已启用（vpssh-upgrade.path、vpssh-uninstall.path）" "Web upgrade and uninstall enabled (vpssh-upgrade.path, vpssh-uninstall.path)")"
}

# 卸载：install.sh 在服务器上留了一份 uninstall.sh
cmd_uninstall() {
	require_root
	[[ -f "$ROOT/uninstall.sh" ]] || die "$(M "找不到 $ROOT/uninstall.sh" "$ROOT/uninstall.sh is missing")"
	# 复制出来再跑：卸载会删掉 $ROOT
	local copy
	copy=$(mktemp /tmp/vpssh-uninstall.XXXXXX.sh)
	cp "$ROOT/uninstall.sh" "$copy"
	bash "$copy" "$@"
}

cmd_uninstall_run() {
	require_root
	[[ -f "$UNINSTALL_REQUEST" ]] || exit 0
	local args=(--yes)
	grep -q '"deleteData":true' "$UNINSTALL_REQUEST" && args+=(--delete-data)
	rm -f "$UNINSTALL_REQUEST"
	# 日志留在 /root：卸载后 $ROOT 就没了
	cmd_uninstall "${args[@]}" >"/root/vpssh-uninstall-$(date +%Y%m%d-%H%M%S).log" 2>&1
}

write_upgrade_status() { # $1=state $2=from $3=to
	local owner
	owner=$(stat -c %U "$ROOT/state" 2>/dev/null || echo vpssh)
	printf '{"state":"%s","from":"%s","to":"%s","at":%s}\n' "$1" "$2" "$3" "$(date +%s)000" >"$UPGRADE_STATUS"
	chown "$owner" "$UPGRADE_STATUS" 2>/dev/null || true
	chmod 600 "$UPGRADE_STATUS"
}

cmd_upgrade_run() {
	require_root
	# 先删请求文件：path 单元在文件仍存在时会再次触发
	[[ -f "$UPGRADE_REQUEST" ]] || exit 0
	rm -f "$UPGRADE_REQUEST"
	local from to rc=0 owner
	from=$(installed_vpssh)
	write_upgrade_status running "$from" ""
	owner=$(stat -c %U "$ROOT/state" 2>/dev/null || echo vpssh)
	: >"$UPGRADE_LOG"
	chown "$owner" "$UPGRADE_LOG" 2>/dev/null || true
	chmod 600 "$UPGRADE_LOG"
	# 独立进程执行：写在 `|| rc=$?` 里的函数/子 shell 会让 set -e 失效，出错也不停
	"$ROOT/bin/vpssh" upgrade --yes >>"$UPGRADE_LOG" 2>&1 || rc=$?
	[[ $rc -eq 0 ]] || printf '[vpssh] 升级进程退出码 %s（原因见上一行）\n' "$rc" >>"$UPGRADE_LOG"
	to=$(installed_vpssh)
	if [[ $rc -eq 0 ]]; then
		write_upgrade_status success "$from" "$to"
	else
		write_upgrade_status failed "$from" "$to"
	fi
}

## endregion

usage() {
	if [[ "$(M zh en)" != zh ]]; then
		cat <<'EOF'
vpssh commands
Usage: sudo vpssh <command>
  status              Services, health, version
  repair [--public]   Rescue when the page does not open: restart services, rewrite the site, open ports (--public turns off "only my devices")
  upgrade [--ref R]   Upgrade vpssh as a whole (latest release by default; returns to the previous version on failure)
  rollback            Go back to before the last upgrade
  uninstall [--delete-data]  Uninstall vpssh (backs up first; keeps the data unless --delete-data)
  restart             Restart vpssh
  backup              Back up the data to /opt/vpssh/backups/ (keeps 3)
  reset-admin [--yes] Delete the admin account and run first-time setup again (new token)
  setup-url           Print the first-time setup link (with its one-time token)
  vpn ...             "Only my devices" access through WireGuard (sudo vpssh vpn for help)
  tunnel              Reach vpssh through an SSH tunnel instead
  ownshost [on|off|status]  Settings patch for access over a domain
  selfcheck           Run the self-check
EOF
		return
	fi
	cat <<'EOF'
vpssh 管理命令
用法: sudo vpssh <子命令>
  status              服务状态 + 健康 + 版本提示
  restart             重启 gate（DSH 随之重启并重新兑换会话）
  upgrade [--ref R]   整体升级 vpssh（默认最新发布版；失败自动回到升级前）
  ownshost [on|off|status]  设置页可用性补丁（公网域名下解除"设置不可用"）
  rollback            回到上一次升级之前（恢复快照）
  reset-admin [--yes] 删除管理员与向导锁，重新走初始设置（换发令牌）
  setup-url          打印初始设置链接（含一次性令牌）
  backup              备份数据到 /opt/vpssh/backups/（保留 3 份）
  selfcheck           手动触发回归自检探针
  uninstall [--delete-data]  卸载 vpssh（先备份；默认保留数据）
  repair [--public]   网页打不开时救援：拉起服务、重写站点、放行端口（--public 关掉「仅我的设备」）
EOF
}

case "${1:-}" in
status) cmd_status ;;
restart) cmd_restart ;;
upgrade) shift; cmd_upgrade "$@" ;;
ownshost) shift; cmd_ownshost "$@" ;;
rollback) cmd_rollback ;;
reset-admin) shift; cmd_reset_admin "$@" ;;
setup-url) cmd_setup_url ;;
backup) cmd_backup ;;
selfcheck) cmd_selfcheck ;;
repair) shift; cmd_repair "$@" ;;
uninstall) shift; cmd_uninstall "$@" ;;
uninstall-run) cmd_uninstall_run ;;
install-units) cmd_install_units ;;
upgrade-run) cmd_upgrade_run ;;
vpn) shift; cmd_vpn "$@" ;;
tunnel) cmd_tunnel ;;
"" | -h | --help) usage ;;
*) usage; die "$(M "未知子命令: $1" "Unknown command: $1")" ;;
esac
